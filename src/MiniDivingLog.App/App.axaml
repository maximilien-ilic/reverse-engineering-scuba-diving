<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MiniDivingLog.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <!-- Police de l'application (étape 10) : Poppins, embarquée dans Assets/Fonts.
         Le thème Fluent lit cette ressource pour tous ses contrôles (boutons, champs, listes…). -->
    <FontFamily x:Key="ContentControlThemeFontFamily">avares://MiniDivingLog.App/Assets/Fonts#Poppins</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Les fenêtres aussi : tout ce qui n'est pas un contrôle Fluent (TextBlock, infobulles…) en hérite. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
    </Style>

    <!-- Le grand titre de la fenêtre. -->
    <Style Selector="TextBlock.titre">
      <Setter Property="FontSize" Value="32" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="LetterSpacing" Value="0.5" />
    </Style>

    <!-- Direction artistique (étape 9) : bleus de l'eau, boutons orange. -->

    <!-- Les cartes blanches translucides posées sur le fond aurora. -->
    <Style Selector="Border.carte">
      <Setter Property="Background" Value="#EBFFFFFF" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 10 30 0 #66031B3D" />
    </Style>

    <!-- Boutons orange. -->
    <Style Selector="Button">
      <Setter Property="Background" Value="#F57C00" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FB8C00" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E65100" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Bouton secondaire (Annuler) : orange en contour. -->
    <Style Selector="Button.secondaire">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E65100" />
      <Setter Property="BorderBrush" Value="#F57C00" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.secondaire:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFF3E0" />
      <Setter Property="Foreground" Value="#E65100" />
    </Style>

    <!-- Onglets : texte blanc sur le fond, souligné orange quand sélectionné. -->
    <Style Selector="TabControl.onglets > TabItem">
      <Setter Property="Foreground" Value="#B3E5FC" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabControl.onglets > TabItem:selected">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TabControl.onglets > TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="#FF9800" />
    </Style>
  </Application.Styles>
</Application>
