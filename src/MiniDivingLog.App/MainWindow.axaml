<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:MiniDivingLog.App"
        xmlns:carnet="using:MiniDivingLog.Core.Carnet"
        x:Class="MiniDivingLog.App.MainWindow"
        Title="Mini Diving Log" Width="1040" Height="720">

  <Panel>
  <!-- Le fond bleu nuancé (étapes 9 et 10) : premier enfant du Panel, tout le reste s'affiche par-dessus. -->
  <app:FondAurora />
  <DockPanel Margin="24,16,24,24">
  <TextBlock DockPanel.Dock="Top" Classes="titre" Text="Mini Diving Log" Margin="4,0,0,4" />

  <TabControl x:Name="Onglets" Classes="onglets">

    <!-- ===================== Onglet 1 : le carnet ===================== -->
    <TabItem Header="Carnet">
      <Border Classes="carte" Padding="0">
      <DockPanel>
        <!-- Barre du haut : actions -->
        <Border DockPanel.Dock="Top" Padding="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Nouvelle plongée…" Click="Nouvelle_Click" />
            <Button x:Name="BoutonModifier" Content="Modifier…" Click="Modifier_Click" />
            <Button x:Name="BoutonImporter" Content="Importer un fichier UDDF…" Click="Importer_Click" />
            <Button x:Name="BoutonSupprimer" Content="Supprimer la plongée" Click="Supprimer_Click" />
            <TextBlock x:Name="Message" Foreground="#0D47A1" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Barre du bas : statistiques du carnet (étape 3) -->
        <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#330D47A1" CornerRadius="0,0,12,12">
          <TextBlock x:Name="Stats" TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="300,*">
          <!-- Liste des plongées -->
          <ListBox x:Name="ListePlongees" Grid.Column="0" Background="Transparent" SelectionChanged="Liste_SelectionChanged"
                   DoubleTapped="Modifier_Click">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="carnet:Plongee">
                <StackPanel>
                  <TextBlock FontWeight="Bold">
                    <Run Text="N° " /><Run Text="{Binding Numero}" /><Run Text=" · " /><Run Text="{Binding Lieu}" />
                  </TextBlock>
                  <TextBlock Foreground="Gray" Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Détails de la plongée sélectionnée -->
          <DockPanel Grid.Column="1" Margin="12">
            <TextBlock x:Name="Titre" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock x:Name="Details" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" />
            <app:VueProfil x:Name="Profil" MinHeight="250" />
          </DockPanel>
        </Grid>
      </DockPanel>
      </Border>
    </TabItem>

    <!-- ============ Onglet 2 : le planificateur de déco (étape 4) ============ -->
    <TabItem Header="Planificateur">
      <Border Classes="carte">
      <DockPanel>
        <!-- Les paramètres de la plongée -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal">
          <WrapPanel.Styles>
            <Style Selector="NumericUpDown">
              <Setter Property="Width" Value="130" />
              <Setter Property="Margin" Value="0,4,16,8" />
            </Style>
          </WrapPanel.Styles>
          <StackPanel><TextBlock Text="Profondeur (m)" />
            <NumericUpDown x:Name="ChampProfondeur" Value="40" Minimum="3" Maximum="100" Increment="1" FormatString="0" /></StackPanel>
          <StackPanel><TextBlock Text="Durée de fond (min)" />
            <NumericUpDown x:Name="ChampDuree" Value="25" Minimum="1" Maximum="200" Increment="1" FormatString="0" /></StackPanel>
          <StackPanel><TextBlock Text="O2 (%)" />
            <NumericUpDown x:Name="ChampO2" Value="21" Minimum="10" Maximum="100" Increment="1" FormatString="0" /></StackPanel>
          <StackPanel><TextBlock Text="Hélium (%)" />
            <NumericUpDown x:Name="ChampHe" Value="0" Minimum="0" Maximum="90" Increment="5" FormatString="0" /></StackPanel>
          <StackPanel><TextBlock Text="GF bas (%)" />
            <NumericUpDown x:Name="ChampGfBas" Value="30" Minimum="10" Maximum="100" Increment="5" FormatString="0" /></StackPanel>
          <StackPanel><TextBlock Text="GF haut (%)" />
            <NumericUpDown x:Name="ChampGfHaut" Value="70" Minimum="10" Maximum="100" Increment="5" FormatString="0" /></StackPanel>
          <Button Content="Calculer" Click="Calculer_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
        </WrapPanel>

        <Grid ColumnDefinitions="300,*" Margin="0,8,0,0">
          <TextBlock x:Name="ResultatPlan" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,12,0" />
          <app:VueProfil x:Name="ProfilPlan" Grid.Column="1" MinHeight="250" />
        </Grid>
      </DockPanel>
      </Border>
    </TabItem>

    <!-- ============ Onglet 3 : la grille d'activité (étape 9) ============ -->
    <TabItem Header="Activité">
      <Border Classes="carte">
        <StackPanel Spacing="16">
          <TextBlock Text="Tes plongées sur les 12 derniers mois" FontSize="18" FontWeight="Bold" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <app:GrilleActivite x:Name="Grille" />
          </ScrollViewer>
          <TextBlock x:Name="StatsDetaillees" TextWrapping="Wrap" LineHeight="22" />
        </StackPanel>
      </Border>
    </TabItem>
  </TabControl>
  </DockPanel>
  </Panel>
</Window>
